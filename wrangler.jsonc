// The web page at https://zen.dio.la (static; the monk runs in the local companion).
// Deploy: (cd web && bun run build) && bunx wrangler deploy
{
  "name": "zen-dio-la",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./web/dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "zen.dio.la", "custom_domain": true }]
}
